# Copy this file to .env and fill in your own values.
# Never share your real .env file.

# Any long random text. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=home_service_db

# First admin: created automatically when the app starts, if no admin exists yet.
# Change these BEFORE the first start; editing them later has no effect.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-strong-password

# 1 = auto-reload + detailed errors (local only). Use 0 on a live server.
FLASK_DEBUG=0
# 1 when the site is served over HTTPS (live server)
SESSION_COOKIE_SECURE=0

# Cloud MySQL only (e.g. Aiven): path to its CA certificate. Leave empty locally.
DB_SSL_CA=
